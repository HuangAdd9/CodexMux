#!/usr/bin/env python3
"""Synchronize one Codex session and its paginated-history lineage.

Wrappers provide a target CODEX_HOME and the possible source homes. Rollouts
are copied atomically. Exact byte prefixes use a fast path; otherwise, known
Codex JSONL records are compared by stable IDs so legacy and paginated copies
of the same history are not mistaken for independent branches.
"""

from __future__ import annotations

import argparse
import base64
from contextlib import ExitStack, closing, contextmanager
from datetime import datetime
import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import sqlite3
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path


UUID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)
COPY_CHUNK_SIZE = 1024 * 1024
MAX_LINEAGE_DEPTH = 64
DAEMON_RPC_TIMEOUT = 15.0
MAX_DAEMON_MESSAGE = 1024 * 1024


class SyncError(RuntimeError):
    """A session cannot be synchronized without risking data loss."""


class LogicalHistory:
    """Stable records used to compare differently serialized rollouts."""

    def __init__(
        self,
        record_ids: list[str],
        digests: dict[str, str],
        started_turns: set[str],
        completed_turns: set[str],
    ) -> None:
        self.record_ids = tuple(record_ids)
        self.digests = digests
        self.started_turns = frozenset(started_turns)
        self.completed_turns = frozenset(completed_turns)


def parse_args() -> argparse.Namespace:
    arguments = sys.argv[1:]
    command = []
    if "--" in arguments:
        boundary = arguments.index("--")
        command = arguments[boundary + 1:]
        arguments = arguments[:boundary]
    parser = argparse.ArgumentParser(
        description="Synchronize a Codex rollout and its history lineage"
    )
    parser.add_argument("session_id", help="session UUID to synchronize")
    parser.add_argument("target_home", type=Path, help="destination CODEX_HOME")
    parser.add_argument(
        "source_homes",
        nargs="*",
        type=Path,
        help="CODEX_HOME directories to search for source rollouts",
    )
    parser.add_argument(
        "--lock-home",
        type=Path,
        default=Path.home() / ".cache/codex-account/locks",
        help="directory used for short-lived synchronization locks",
    )
    parser.add_argument(
        "--log-prefix",
        default="codex-session-sync",
        help="prefix for synchronization messages",
    )
    parser.add_argument("--session-action", choices=("resume", "fork"), default="resume")
    args = parser.parse_args(arguments)
    args.command = command
    return args


def find_rollout(sessions_dir: Path, session_id: str) -> Path | None:
    if not sessions_dir.is_dir():
        return None

    matches = sorted(set(sessions_dir.rglob(f"*-{session_id}.jsonl"))
                     | set(sessions_dir.rglob(f"*_{session_id}.jsonl")))
    if len(matches) > 1:
        paths = ", ".join(str(path) for path in matches)
        raise SyncError(f"multiple rollouts for {session_id} under {sessions_dir}: {paths}")
    return matches[0] if matches else None


def rollout_id(path: Path) -> str:
    identifier = path.stem[-36:]
    if not UUID_RE.fullmatch(identifier):
        raise SyncError(f"unrecognized rollout filename: {path}")
    return identifier.lower()


def session_metadata(path: Path) -> dict:
    with path.open(encoding="utf-8") as handle:
        record = json.loads(handle.readline())
    payload = record.get("payload")
    if record.get("type") != "session_meta" or not isinstance(payload, dict):
        raise SyncError(f"invalid session metadata: {path}")
    return payload


def open_state(home: Path, name: str):
    path = home / name
    return sqlite3.connect(path.as_uri() + "?mode=ro", uri=True, timeout=5)


def selected_thread(home: Path, session_id: str) -> dict | None:
    if not (home / "state_5.sqlite").exists():
        return None
    with closing(open_state(home, "state_5.sqlite")) as connection:
        connection.row_factory = sqlite3.Row
        row = connection.execute("SELECT * FROM threads WHERE id = ?", (session_id,)).fetchone()
    return dict(row) if row else None


def managed_rollout(home: Path, path: Path) -> Path:
    resolved = path.resolve()
    if not resolved.is_relative_to((home / "sessions").resolve()) or not resolved.is_file():
        raise SyncError(f"selected rollout is missing or outside managed sessions: {path}")
    if resolved.suffix != ".jsonl":
        raise SyncError(f"compressed selected rollouts require native decompression first: {path}")
    return resolved


def compatible_segment(identifier: str, homes: list[Path], preferred: Path | None = None) -> Path:
    candidates = [managed_rollout(home, path) for home in homes
                  if (path := find_rollout(home / "sessions", identifier)) is not None]
    if not candidates:
        raise SyncError(f"missing lineage rollout {identifier}")
    snapshots = {path: file_identity(path) for path in candidates}
    source = max(candidates, key=lambda path: snapshots[path][2])
    if not all(is_prefix(path, source, snapshots[path][2]) or
               settings_tail_prefix(path, source) for path in candidates):
        raise SyncError(f"conflicting copies of immutable rollout {identifier}; back up branches first")
    if any(file_identity(path) != snapshot for path, snapshot in snapshots.items()):
        raise SyncError(f"rollout {identifier} changed during comparison; retry after its writer exits")
    if preferred in candidates and snapshots[preferred][2] == snapshots[source][2]:
        return preferred
    return source


def rotated_chain(path: Path, homes: list[Path]) -> list[Path]:
    chain = []
    seen = set()
    while path is not None:
        identifier = rollout_id(path)
        if identifier in seen or len(chain) >= MAX_LINEAGE_DEPTH:
            raise SyncError(f"invalid rollout lineage at {path}")
        logical_id = session_metadata(path).get("id")
        prefix = path.stem[:-37] if path.stem[-37:-36] == "_" else path.stem
        if not isinstance(logical_id, str) or not prefix.endswith("-" + logical_id):
            raise SyncError(f"rollout filename does not match its session metadata: {path}")
        seen.add(identifier)
        chain.append(path)
        reference = read_history_base(path)
        if reference is None:
            break
        path = compatible_segment(reference["thread_id"], homes)
        if reference.get("end_byte_offset") is None or reference.get("end_ordinal_exclusive") is None:
            raise SyncError(f"missing paginated lineage bounds: {path}")
        prefix_snapshot(path, reference["end_byte_offset"])
    return chain


def check_obsolete_continuation(path: Path, replacement: Path) -> None:
    created = session_metadata(replacement).get("timestamp")
    if not created:
        raise SyncError(f"replacement rollout has no creation timestamp: {replacement}")
    cutoff = datetime.fromisoformat(created.replace("Z", "+00:00"))
    with path.open(encoding="utf-8") as handle:
        for line in handle:
            record = json.loads(line)
            payload = record.get("payload", {})
            meaningful = (record.get("type") in ("response_item", "compacted") or
                          record.get("type") == "event_msg" and
                          payload.get("type") in ("task_started", "user_message"))
            if not meaningful:
                continue
            timestamp = record.get("timestamp")
            if not timestamp or datetime.fromisoformat(timestamp.replace("Z", "+00:00")) >= cutoff:
                raise SyncError(
                    f"session continued independently after revert: {path}; back up branches first"
                )


HISTORY_TABLES = ("thread_turns", "thread_items", "thread_realtime_items",
                  "thread_history_projection_state")


def projection_complete(home: Path, paths: list[Path]) -> bool:
    if not (home / "thread_history_1.sqlite").exists():
        return False
    with closing(open_state(home, "thread_history_1.sqlite")) as connection:
        for path in paths:
            row = connection.execute(
                "SELECT next_rollout_byte_offset FROM thread_history_projection_state WHERE thread_id = ?",
                (rollout_id(path),),
            ).fetchone()
            if row is None or row[0] != path.stat().st_size:
                return False
    return True


def copy_history_rows(source, destination, identifier: str, schema: str = "main") -> None:
    for table in HISTORY_TABLES:
        source_columns = [row[1] for row in source.execute(f'PRAGMA table_info("{table}")')]
        target_columns = [row[1] for row in destination.execute(f'PRAGMA {schema}.table_info("{table}")')]
        if source_columns != target_columns or not source_columns:
            raise SyncError(f"incompatible history database schema: {table}")
        destination.execute(f'DELETE FROM {schema}."{table}" WHERE thread_id = ?', (identifier,))
        rows = source.execute(f'SELECT * FROM "{table}" WHERE thread_id = ?', (identifier,))
        placeholders = ",".join("?" for _column in source_columns)
        while batch := rows.fetchmany(256):
            destination.executemany(f'INSERT INTO {schema}."{table}" VALUES ({placeholders})', batch)


def synchronize_rotated(args, homes: list[Path], stack: ExitStack) -> bool:
    selections = []
    for home in homes:
        row = selected_thread(home, args.session_id)
        if row:
            path = Path(row["rollout_path"])
            if rollout_id(path) != args.session_id:
                managed_rollout(home, path)
            selections.append((home, path, row))
        else:
            if next((home / "sessions").rglob(f"*-{args.session_id}_*.jsonl"), None):
                raise SyncError("replacement rollouts exist without an authoritative SQLite pointer")
            path = find_rollout(home / "sessions", args.session_id)
            if path:
                selections.append((home, path, None))
    chains = {}
    for _home, path, row in selections:
        if row is not None and (rollout_id(path) != args.session_id or path.exists() and
                                session_metadata(path).get("history_mode") == "paginated" and
                                read_history_base(path)):
            chain = rotated_chain(compatible_segment(rollout_id(path), homes, path), homes)
            if any(segment.stem[-37:-36] == "_" for segment in chain):
                chains[path] = chain
    rotated = [entry for entry in selections if entry[1] in chains]
    if not rotated:
        if any(next((home / "sessions").rglob(f"*-{args.session_id}_*.jsonl"), None)
               for home in homes):
            raise SyncError("replacement rollouts exist without an authoritative SQLite pointer")
        return False

    heads = {rollout_id(path): path for _home, path, _row in rotated}
    leaves = [path for identifier, path in heads.items()
              if not any(identifier in {rollout_id(parent) for parent in chain[1:]}
                         for chain in chains.values())]
    if len(leaves) != 1:
        raise SyncError("divergent replacement rollouts; back up branches before choosing one")
    selected = leaves[0]
    chain = chains[selected]
    if session_metadata(chain[0]).get("id") != args.session_id:
        raise SyncError(f"selected rollout belongs to another session: {selected}")
    snapshots = {path: file_identity(path) for path in chain}
    identifiers = [rollout_id(path) for path in chain]
    logical_ids = {session_metadata(path).get("id") for path in chain}
    for identifier in sorted(logical_ids - {args.session_id}, key=str):
        if not isinstance(identifier, str) or not UUID_RE.fullmatch(identifier):
            raise SyncError("invalid logical session ID in rollout lineage")
        stack.enter_context(session_lock(args.lock_home, identifier))
        for home in homes:
            native_writer_guard(home, identifier, stack)
    for _home, path, _row in selections:
        identifier = rollout_id(path)
        if identifier not in identifiers:
            raise SyncError(f"unrelated active rollout for session {args.session_id}: {path}")
        if identifier != identifiers[0]:
            check_obsolete_continuation(compatible_segment(identifier, homes), chain[identifiers.index(identifier) - 1])

    target = homes[0]
    original_row = selected_thread(target, args.session_id)
    destinations = [(path, target / "sessions" / relative_rollout_path(path, homes)) for path in chain]
    if original_row and original_row["rollout_path"] == str(destinations[0][1]) and all(
        destination.exists() and file_identity(source)[2] == file_identity(destination)[2]
        and is_prefix(source, destination, source.stat().st_size)
        for source, destination in destinations
    ) and projection_complete(target, chain):
        return True

    source_row = next(row for _home, path, row in rotated if path == selected)
    if not (target / "state_5.sqlite").exists() or not (target / "thread_history_1.sqlite").exists():
        raise SyncError("initialize this account with native Codex once before importing paginated history")
    sources = []
    for path in chain:
        home = next(home for home in homes if path.is_relative_to(home / "sessions"))
        connection = open_state(home, "thread_history_1.sqlite")
        stack.callback(connection.close)
        connection.execute("BEGIN")
        projection = connection.execute(
            "SELECT next_rollout_byte_offset FROM thread_history_projection_state WHERE thread_id = ?",
            (rollout_id(path),),
        ).fetchone()
        if projection is None or projection[0] != path.stat().st_size:
            raise SyncError(f"history projection is incomplete for {path}; resume and exit its source first")
        if home == target:
            connection.close()
            sources.append(None)
        else:
            sources.append(connection)

    backup_root = args.lock_home.parent / "backups" / args.session_id
    backup_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    backup = Path(tempfile.mkdtemp(prefix="rollout-sync-", dir=backup_root))
    backup.chmod(0o700)
    (backup / "thread.json").write_text(json.dumps(original_row, ensure_ascii=False) + "\n")
    with closing(sqlite3.connect(target / "thread_history_1.sqlite", timeout=5)) as history, \
            closing(sqlite3.connect(backup / "history.sqlite")) as saved, saved:
        for table in HISTORY_TABLES:
            schema = history.execute("SELECT sql FROM sqlite_master WHERE name = ?", (table,)).fetchone()
            if schema is None:
                raise SyncError(f"missing history table: {table}")
            saved.execute(schema[0])
        for identifier in identifiers:
            copy_history_rows(history, saved, identifier)
    print(f"[{args.log_prefix}] session_backup={backup}", file=sys.stderr)
    for source, destination in reversed(destinations):
        if source == destination:
            continue
        if destination.exists():
            shutil.copy2(destination, backup / destination.name)
        copy_atomically(source, destination)

    with closing(sqlite3.connect(target / "state_5.sqlite", timeout=5)) as state, state:
        state.execute("ATTACH DATABASE ? AS history", (str(target / "thread_history_1.sqlite"),))
        state.execute("BEGIN IMMEDIATE")
        state.row_factory = sqlite3.Row
        current = state.execute("SELECT * FROM threads WHERE id = ?", (args.session_id,)).fetchone()
        if (dict(current) if current else None) != original_row:
            raise SyncError("target session metadata changed during synchronization")
        for source, identifier in zip(sources, identifiers):
            if source is not None:
                copy_history_rows(source, state, identifier, schema="history")
        if any(file_identity(path) != snapshot for path, snapshot in snapshots.items()):
            raise SyncError("source lineage changed during synchronization")
        for home, path, row in selections:
            current_source = selected_thread(home, args.session_id)
            if (row is None and current_source is not None or row is not None and
                    (current_source is None or current_source["rollout_path"] != str(path))):
                raise SyncError("source rollout pointer changed during synchronization")
        if original_row:
            state.execute("UPDATE threads SET rollout_path = ?, history_mode = 'paginated' WHERE id = ?",
                          (str(destinations[0][1]), args.session_id))
        else:
            columns = {row[1] for row in state.execute("PRAGMA table_info(threads)")}
            values = {key: value for key, value in source_row.items() if key in columns}
            values.update(rollout_path=str(destinations[0][1]), thread_section_id=None, project_id=None)
            values = {key: value for key, value in values.items() if key in columns}
            names = ",".join(f'"{key}"' for key in values)
            placeholders = ",".join("?" for _key in values)
            state.execute(f"INSERT INTO threads ({names}) VALUES ({placeholders})", tuple(values.values()))
    print(f"[{args.log_prefix}] selected_rollout={identifiers[0]} lineage_segments={len(chain)}", file=sys.stderr)
    return True


def read_history_base(rollout: Path) -> dict | None:
    try:
        with rollout.open("r", encoding="utf-8") as handle:
            metadata = json.loads(handle.readline())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise SyncError(f"cannot read session metadata from {rollout}: {exc}") from exc

    if metadata.get("type") != "session_meta":
        raise SyncError(f"rollout first line is not session_meta: {rollout}")

    payload = metadata.get("payload")
    if not isinstance(payload, dict):
        raise SyncError(f"invalid session_meta payload: {rollout}")

    history_base = payload.get("history_base")
    if history_base is None:
        return None
    if not isinstance(history_base, dict):
        raise SyncError(f"invalid history_base: {rollout}")

    parent_id = history_base.get("thread_id")
    if parent_id is None:
        return None
    if not isinstance(parent_id, str) or not UUID_RE.fullmatch(parent_id):
        raise SyncError(f"invalid history_base.thread_id: {rollout}")
    for key, minimum in (("end_byte_offset", 1), ("end_ordinal_exclusive", 0)):
        value = history_base.get(key)
        if value is not None and (type(value) is not int or value < minimum):
            raise SyncError(f"invalid history_base.{key}: {rollout}")
    return history_base


def read_parent_id(rollout: Path) -> str | None:
    reference = read_history_base(rollout)
    return reference["thread_id"] if reference else None


def prefix_snapshot(path: Path, length: int) -> tuple[int, int, int, str]:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        metadata = os.fstat(handle.fileno())
        if metadata.st_size < length:
            raise SyncError(f"referenced parent history is incomplete: {path}")
        handle.seek(length - 1)
        if handle.read(1) != b"\n":
            raise SyncError(f"history_base.end_byte_offset is not a record boundary: {path}")
        handle.seek(0)
        remaining = length
        while remaining:
            chunk = handle.read(min(COPY_CHUNK_SIZE, remaining))
            if not chunk:
                raise SyncError(f"referenced parent history was truncated: {path}")
            digest.update(chunk)
            remaining -= len(chunk)
        current = path.stat()
        if (current.st_dev, current.st_ino) != (metadata.st_dev, metadata.st_ino) or current.st_size < length:
            raise SyncError(f"referenced parent history changed during preflight: {path}")
    return metadata.st_dev, metadata.st_ino, length, digest.hexdigest()


def complete_local_parent(path: Path | None, reference: dict | None) -> bool:
    if path is None or reference is None:
        return False
    boundary = reference.get("end_byte_offset")
    if boundary is None or reference.get("end_ordinal_exclusive") is None:
        return False
    if path.stat().st_size < boundary:
        return False
    with path.open("rb") as handle:
        header = handle.readline()
    try:
        metadata = json.loads(header)
        identifier = metadata.get("payload", {}).get("id")
        valid_id = isinstance(identifier, str) and identifier.lower() == reference["thread_id"].lower()
        if metadata.get("type") != "session_meta" or not valid_id or len(header) > boundary:
            raise SyncError(f"local parent metadata does not match history_base: {path}")
    except (ValueError, AttributeError) as exc:
        raise SyncError(f"invalid local parent metadata: {path}") from exc
    return True


def is_prefix(shorter: Path, longer: Path, length: int) -> bool:
    remaining = length
    with shorter.open("rb") as left, longer.open("rb") as right:
        while remaining:
            chunk_size = min(COPY_CHUNK_SIZE, remaining)
            left_chunk = left.read(chunk_size)
            if len(left_chunk) != chunk_size or left_chunk != right.read(chunk_size):
                return False
            remaining -= chunk_size
    return True


def settings_tail_prefix(shorter: Path, longer: Path) -> bool:
    diverged = False
    with shorter.open("rb") as left, longer.open("rb") as right:
        for line in left:
            other = right.readline()
            if not diverged and line == other:
                continue
            diverged = True
            try:
                record = json.loads(line)
            except (ValueError, UnicodeDecodeError):
                return False
            if (not line.endswith(b"\n") or not isinstance(record, dict) or
                    record.get("type") != "event_msg" or
                    not isinstance(record.get("payload"), dict) or
                    record["payload"].get("type") != "thread_settings_applied"):
                return False
    return True


def normalize_payload(value):
    """Normalize missing versus null content fields across history formats."""

    if isinstance(value, dict):
        return {
            key: normalize_payload(item)
            for key, item in value.items()
            if not (key == "content" and item is None)
        }
    if isinstance(value, list):
        return [normalize_payload(item) for item in value]
    return value


def payload_digest(payload: dict) -> str:
    """Hash semantic payload data while tolerating one known format change."""

    normalized = normalize_payload(payload)
    serialized = json.dumps(
        normalized,
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return hashlib.sha256(serialized).hexdigest()


def stable_record(item: dict) -> tuple[str, str] | None:
    """Return a stable record ID and digest for history-bearing record types."""

    record_type = item.get("type")
    payload = item.get("payload")
    if not isinstance(payload, dict):
        return None

    if record_type == "response_item":
        identifier = payload.get("id")
        if not isinstance(identifier, str):
            identifier = payload.get("call_id")
        if not isinstance(identifier, str) or not identifier:
            raise ValueError("response_item has no stable ID")
        return f"response:{identifier}", payload_digest(payload)

    if record_type == "compacted":
        identifier = payload.get("compaction_response_id")
        if isinstance(identifier, str) and identifier:
            return f"compacted:{identifier}", payload_digest(payload)
    return None


def read_logical_history(path: Path, session_id: str) -> LogicalHistory:
    """Read stable comparison data without retaining full JSONL payloads."""

    record_ids: list[str] = []
    digests: dict[str, str] = {}
    started_turns: set[str] = set()
    completed_turns: set[str] = set()

    try:
        with path.open("r", encoding="utf-8") as handle:
            for line_number, line in enumerate(handle, start=1):
                item = json.loads(line)
                if not isinstance(item, dict):
                    raise ValueError(f"line {line_number} is not a JSON object")

                if line_number == 1:
                    payload = item.get("payload")
                    identifier = payload.get("id") if isinstance(payload, dict) else None
                    if item.get("type") != "session_meta" or identifier != session_id:
                        raise ValueError("first record does not match the session ID")

                record = stable_record(item)
                if record is not None:
                    identifier, digest = record
                    previous = digests.get(identifier)
                    if previous is not None and previous != digest:
                        raise ValueError(f"stable ID {identifier} has conflicting payloads")
                    record_ids.append(identifier)
                    digests[identifier] = digest

                if item.get("type") == "event_msg":
                    payload = item.get("payload")
                    if not isinstance(payload, dict):
                        continue
                    turn_id = payload.get("turn_id")
                    if not isinstance(turn_id, str) or not turn_id:
                        continue
                    if payload.get("type") == "task_started":
                        started_turns.add(turn_id)
                    elif payload.get("type") == "task_complete":
                        completed_turns.add(turn_id)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
        raise SyncError(f"cannot compare logical history in {path}: {exc}") from exc

    if not record_ids:
        raise SyncError(f"no stable history records in {path}")
    return LogicalHistory(record_ids, digests, started_turns, completed_turns)


def is_ordered_subsequence(shorter: tuple[str, ...], longer: tuple[str, ...]) -> bool:
    """Return whether every shorter record occurs in order in longer."""

    position = 0
    for identifier in longer:
        if position < len(shorter) and identifier == shorter[position]:
            position += 1
    return position == len(shorter)


def logical_history_contains(longer: LogicalHistory, shorter: LogicalHistory) -> bool:
    """Return whether longer safely contains every known part of shorter."""

    if not shorter.started_turns.issubset(longer.started_turns):
        return False
    if not shorter.completed_turns.issubset(longer.completed_turns):
        return False
    for identifier, digest in shorter.digests.items():
        if longer.digests.get(identifier) != digest:
            return False
    return is_ordered_subsequence(shorter.record_ids, longer.record_ids)


def choose_logical_source(
    session_id: str,
    target_rollout: Path | None,
    candidates: list[Path],
    snapshots: dict[Path, tuple[int, int, int, int, int]],
) -> Path | None:
    """Choose a single history that semantically contains all other copies."""

    try:
        histories = {
            candidate: read_logical_history(candidate, session_id)
            for candidate in candidates
        }
    except SyncError:
        return None

    complete = [
        candidate
        for candidate in candidates
        if all(
            logical_history_contains(histories[candidate], histories[other])
            for other in candidates
        )
    ]
    if not complete:
        return None
    if target_rollout in complete:
        return target_rollout
    return max(
        complete,
        key=lambda path: (
            len(histories[path].record_ids),
            snapshots[path][3],
            str(path),
        ),
    )


def unique_homes(target_home: Path, source_homes: list[Path]) -> list[Path]:
    homes: list[Path] = []
    seen: set[Path] = set()
    for home in [target_home, *source_homes]:
        resolved = home.expanduser().resolve()
        if resolved in seen:
            continue
        seen.add(resolved)
        homes.append(resolved)
    return homes


def file_identity(path: Path) -> tuple[int, int, int, int, int]:
    metadata = path.stat()
    return (metadata.st_dev, metadata.st_ino, metadata.st_size,
            metadata.st_mtime_ns, metadata.st_ctime_ns)


@contextmanager
def session_lock(lock_home: Path, session_id: str):
    lock_home.mkdir(parents=True, exist_ok=True)
    session_hash = hashlib.sha256(session_id.lower().encode()).hexdigest()
    with (lock_home / f"session-{session_hash}.lock").open("a+b") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise SyncError(f"session {session_id} is already in use by another wrapper") from exc
        yield


@contextmanager
def native_writer_lock(home: Path, session_id: str):
    directory = home / "thread-writer-locks"
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{session_id}.lock"
    with (directory / ".coordination.lock").open("a+b") as coordination:
        try:
            fcntl.flock(coordination, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise SyncError(f"native writer coordination is busy in {home}; retry shortly") from exc
        handle = path.open("a+b")
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            handle.close()
            raise SyncError(f"session {session_id} has an active native writer in {home}") from exc
        except OSError:
            handle.close()
            raise
    try:
        yield
    finally:
        try:
            with (directory / ".coordination.lock").open("a+b") as coordination:
                fcntl.flock(coordination, fcntl.LOCK_EX)
                try:
                    if path.stat().st_ino == os.fstat(handle.fileno()).st_ino:
                        path.unlink()
                except FileNotFoundError:
                    pass
                handle.close()
        except OSError as exc:
            print(f"codex-session-sync: could not clean up {path}: {exc}", file=sys.stderr)
        finally:
            handle.close()


def native_writer_guard(home: Path, session_id: str, stack: ExitStack) -> ExitStack:
    lifetime = stack.enter_context(ExitStack())
    lifetime.enter_context(native_writer_lock(home, session_id))
    return lifetime


def choose_source(
    session_id: str,
    target_rollout: Path | None,
    homes: list[Path],
) -> Path | None:
    candidates = [
        rollout
        for home in homes
        if (rollout := find_rollout(home / "sessions", session_id)) is not None
    ]
    if not candidates:
        return None

    snapshots = {candidate: file_identity(candidate) for candidate in candidates}
    byte_source = max(candidates, key=lambda path: snapshots[path][2])
    source_size = snapshots[byte_source][2]
    byte_compatible = all(
        candidate.samefile(byte_source)
        or is_prefix(candidate, byte_source, min(snapshots[candidate][2], source_size))
        for candidate in candidates
    )

    if byte_compatible:
        source = byte_source
        if target_rollout is not None and snapshots[target_rollout][2] == source_size:
            source = target_rollout
    else:
        source = choose_logical_source(session_id, target_rollout, candidates, snapshots)
        if source is None:
            paths = ", ".join(str(path) for path in candidates)
            raise SyncError(
                f"divergent copies of session {session_id}: {paths}; histories conflict, "
                "not a stale lock. Back up all branches before choosing one"
            )
    if any(file_identity(path) != snapshot for path, snapshot in snapshots.items()):
        raise SyncError(f"session {session_id} changed during comparison; retry after its writer exits")
    return source


def copy_atomically(source: Path, destination: Path) -> None:
    source_identity = file_identity(source)
    source_size = source_identity[2]
    destination_identity = file_identity(destination) if destination.exists() else None
    destination.parent.mkdir(parents=True, exist_ok=True)

    fd, temporary_name = tempfile.mkstemp(
        prefix=f".{destination.name}.", suffix=".importing", dir=destination.parent
    )
    temporary = Path(temporary_name)
    try:
        with os.fdopen(fd, "wb") as output, source.open("rb") as input_file:
            shutil.copyfileobj(input_file, output, length=COPY_CHUNK_SIZE)
            output.flush()
            os.fsync(output.fileno())

        if file_identity(source) != source_identity:
            raise SyncError(f"source rollout changed while copying: {source}")
        if temporary.stat().st_size != source_size:
            raise SyncError(f"incomplete rollout copy: {source}")

        shutil.copystat(source, temporary, follow_symlinks=True)
        current_destination = file_identity(destination) if destination.exists() else None
        if current_destination != destination_identity:
            raise SyncError(f"destination rollout changed while copying: {destination}")
        os.replace(temporary, destination)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def relative_rollout_path(source: Path, homes: list[Path]) -> Path:
    for home in homes:
        sessions_dir = home / "sessions"
        try:
            return source.relative_to(sessions_dir)
        except ValueError:
            continue
    raise SyncError(f"source rollout is outside known session roots: {source}")


def synchronize(args: argparse.Namespace) -> None:
    if not UUID_RE.fullmatch(args.session_id):
        raise SyncError(f"invalid session UUID: {args.session_id}")

    target_home = args.target_home.expanduser().resolve()
    target_sessions = target_home / "sessions"
    target_sessions.mkdir(parents=True, exist_ok=True)
    homes = unique_homes(target_home, args.source_homes)

    args.lock_home.mkdir(parents=True, exist_ok=True)
    target_hash = hashlib.sha256(str(target_home).encode()).hexdigest()
    lock_path = args.lock_home / f"home-sync-{target_hash}.lock"

    with ExitStack() as lineage_locks, lock_path.open("a+b") as lock_file:
        fcntl.flock(lock_file, fcntl.LOCK_EX)
        if synchronize_rotated(args, homes, lineage_locks):
            return
        current_id: str | None = args.session_id
        seen_ids: set[str] = set()
        copies = []
        snapshots = {}
        bounded_parents = {}
        parent_reference = None
        local_lineage = True

        for _depth in range(MAX_LINEAGE_DEPTH):
            if current_id is None:
                break
            if current_id in seen_ids:
                raise SyncError(f"lineage cycle detected at session {current_id}")
            seen_ids.add(current_id)
            target_rollout = find_rollout(target_sessions, current_id)
            local_parent = (current_id != args.session_id and local_lineage
                            and complete_local_parent(target_rollout, parent_reference))
            if local_parent:
                source = target_rollout
                boundary = parent_reference["end_byte_offset"]
                bounded_parents[source] = prefix_snapshot(source, boundary)
            else:
                if current_id != args.session_id:
                    lineage_locks.enter_context(session_lock(args.lock_home, current_id))
                    for home in homes:
                        native_writer_guard(home, current_id, lineage_locks)
                source = choose_source(current_id, target_rollout, homes)
            if source is None:
                if current_id == args.session_id:
                    return
                raise SyncError(
                    f"session {args.session_id} is missing lineage rollout {current_id}"
                )

            if source != target_rollout:
                if target_rollout is not None:
                    destination = target_rollout
                else:
                    relative_path = relative_rollout_path(source, homes)
                    destination = target_sessions / relative_path
                copies.append((current_id, source, destination))
            if not local_parent:
                snapshots[source] = file_identity(source)
            local_lineage = local_lineage and source == target_rollout
            parent_reference = read_history_base(source)
            current_id = parent_reference["thread_id"].lower() if parent_reference else None
        else:
            raise SyncError(
                f"session {args.session_id} lineage exceeds {MAX_LINEAGE_DEPTH} levels"
            )

        for source, snapshot in snapshots.items():
            if file_identity(source) != snapshot:
                raise SyncError(f"lineage changed during preflight: {source}")
        for source, snapshot in bounded_parents.items():
            if prefix_snapshot(source, snapshot[2]) != snapshot:
                raise SyncError(f"referenced parent prefix changed during preflight: {source}")
        for current_id, source, destination in reversed(copies):
            copy_atomically(source, destination)
            print(
                f"[{args.log_prefix}] imported_session={current_id}",
                file=sys.stderr,
            )
            print(f"[{args.log_prefix}] imported_from={source}", file=sys.stderr)
        for source, snapshot in bounded_parents.items():
            print(f"[{args.log_prefix}] local_parent_prefix={source.name} bytes={snapshot[2]} (read-only)",
                  file=sys.stderr)


def run_command(command: list[str]) -> int:
    child = subprocess.Popen(command, close_fds=True)
    previous_handlers = {}

    def forward_signal(signum, _frame):
        try:
            child.send_signal(signum)
        except ProcessLookupError:
            pass

    try:
        for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            previous_handlers[signum] = signal.signal(signum, forward_signal)
        returncode = child.wait()
        return returncode if returncode >= 0 else 128 - returncode
    finally:
        for signum, handler in previous_handlers.items():
            signal.signal(signum, handler)


def interactive_resume_index(command: list[str]) -> int | None:
    if not command:
        return None
    position = 0
    if Path(command[0]).name == "env":
        position = 1
        while position < len(command) and re.match(r"^[A-Za-z_][A-Za-z_0-9]*=", command[position]):
            position += 1
    position += 1
    value_options = {
        "-c", "--config", "-m", "--model", "-p", "--profile",
        "-C", "--cd", "-s", "--sandbox", "-a", "--ask-for-approval",
        "--enable", "--disable", "--add-dir", "-i", "--image", "--local-provider",
    }
    flag_options = {
        "--search", "--no-alt-screen", "--oss", "--approve-for-me",
        "--dangerously-bypass-approvals-and-sandbox", "--dangerously-bypass-hook-trust",
        "--strict-config", "--worktree",
    }
    if any(argument == "--remote" or argument.startswith("--remote=")
           for argument in command[position:]):
        return None
    while position < len(command):
        argument = command[position]
        if argument in value_options:
            position += 2
        elif argument in flag_options or argument.split("=", 1)[0] in value_options:
            position += 1
        else:
            return position if argument == "resume" else None
    return None


def local_daemon_writer(home: Path, session_id: str) -> tuple[int, Path] | None:
    endpoint = home / "app-server-control/app-server-control.sock"
    lock_path = home / "thread-writer-locks" / f"{session_id}.lock"
    try:
        metadata = lock_path.stat()
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(1.0)
            connection.connect(str(endpoint))
            credentials = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
            daemon_pid, daemon_uid, _group = struct.unpack("3i", credentials)
        if daemon_uid != os.getuid():
            return None
        if b"app-server" not in Path(f"/proc/{daemon_pid}/cmdline").read_bytes().split(b"\0"):
            return None
        expected_identity = (os.major(metadata.st_dev), os.minor(metadata.st_dev), metadata.st_ino)
        for line in Path("/proc/locks").read_text().splitlines():
            fields = line.split()
            if len(fields) != 8 or fields[1:4] != ["FLOCK", "ADVISORY", "WRITE"]:
                continue
            major, minor, inode = fields[5].split(":")
            identity = (int(major, 16), int(minor, 16), int(inode))
            if int(fields[4]) == daemon_pid and identity == expected_identity:
                return daemon_pid, endpoint
    except (OSError, AttributeError, ValueError):
        return None
    return None


class DaemonClient:
    """Bounded JSON-RPC over the local daemon's Unix WebSocket, without dependencies."""

    def __init__(self, endpoint: Path, expected_pid: int):
        self.endpoint = endpoint
        self.expected_pid = expected_pid
        self.connection = None
        self.request_id = 0
        self.deadline = 0.0

    def __enter__(self):
        self.connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            self.connection.settimeout(DAEMON_RPC_TIMEOUT)
            self.connection.connect(str(self.endpoint))
            credentials = self.connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12)
            peer_pid, peer_uid, _group = struct.unpack("3i", credentials)
            if peer_pid != self.expected_pid or peer_uid != os.getuid():
                raise SyncError("daemon identity changed before provider verification; retry")
            self.deadline = time.monotonic() + DAEMON_RPC_TIMEOUT
            nonce = base64.b64encode(os.urandom(16)).decode("ascii")
            self.connection.sendall((
                "GET / HTTP/1.1\r\nHost: localhost\r\nConnection: Upgrade\r\n"
                "Upgrade: websocket\r\nSec-WebSocket-Version: 13\r\n"
                f"Sec-WebSocket-Key: {nonce}\r\n\r\n"
            ).encode("ascii"))
            header = bytearray()
            while not header.endswith(b"\r\n\r\n") and len(header) < 16384:
                header.extend(self.receive_exactly(1))
            lines = bytes(header).decode("latin1").split("\r\n")
            expected_accept = base64.b64encode(hashlib.sha1(
                (nonce + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode("ascii")
            ).digest()).decode("ascii")
            headers = {name.lower(): value.strip() for line in lines[1:] if ":" in line
                       for name, value in [line.split(":", 1)]}
            if (not header.endswith(b"\r\n\r\n") or lines[0].split()[1:2] != ["101"]
                    or headers.get("sec-websocket-accept") != expected_accept):
                raise SyncError("daemon WebSocket handshake failed; refusing unverified provider")
            self.request("initialize", {
                "clientInfo": {"name": "codex_account_wrapper", "version": "1.0"},
                "capabilities": {"experimentalApi": True},
            })
            self.send_frame(json.dumps({"method": "initialized"}).encode())
            return self
        except BaseException:
            self.connection.close()
            raise

    def __exit__(self, *_exception):
        self.connection.close()

    def receive_exactly(self, length: int) -> bytes:
        data = bytearray()
        while len(data) < length:
            remaining = self.deadline - time.monotonic()
            if remaining <= 0:
                raise SyncError("daemon provider verification timed out")
            self.connection.settimeout(remaining)
            chunk = self.connection.recv(length - len(data))
            if not chunk:
                raise SyncError("daemon disconnected during provider verification")
            data.extend(chunk)
        return bytes(data)

    def send_frame(self, payload: bytes, opcode: int = 1):
        if len(payload) > MAX_DAEMON_MESSAGE:
            raise SyncError("daemon message exceeds size limit")
        mask = os.urandom(4)
        prefix = bytes([0x80 | opcode])
        if len(payload) < 126:
            prefix += bytes([0x80 | len(payload)])
        else:
            prefix += b"\xfe" + struct.pack("!H", len(payload)) if len(payload) <= 65535 else (
                b"\xff" + struct.pack("!Q", len(payload)))
        masked = bytes(value ^ mask[index % 4] for index, value in enumerate(payload))
        self.connection.settimeout(max(0.001, self.deadline - time.monotonic()))
        self.connection.sendall(prefix + mask + masked)

    def receive_message(self) -> dict:
        message = bytearray()
        started = False
        while True:
            first, second = self.receive_exactly(2)
            opcode = first & 0x0F
            length = second & 0x7F
            if first & 0x70 or second & 0x80:
                raise SyncError("unsupported daemon WebSocket frame")
            if length == 126:
                length = struct.unpack("!H", self.receive_exactly(2))[0]
            elif length == 127:
                length = struct.unpack("!Q", self.receive_exactly(8))[0]
            if length + len(message) > MAX_DAEMON_MESSAGE:
                raise SyncError("daemon response exceeds size limit")
            if opcode >= 8 and (not first & 0x80 or length > 125):
                raise SyncError("invalid daemon control frame")
            payload = self.receive_exactly(length)
            if opcode == 8:
                raise SyncError("daemon closed provider verification connection")
            if opcode == 9:
                self.send_frame(payload, opcode=10)
                continue
            if opcode == 10:
                continue
            if opcode != (0 if started else 1):
                raise SyncError("invalid daemon message continuation")
            started = True
            message.extend(payload)
            if first & 0x80:
                try:
                    result = json.loads(message)
                except (ValueError, UnicodeDecodeError) as exc:
                    raise SyncError("invalid daemon JSON response") from exc
                if not isinstance(result, dict):
                    raise SyncError("invalid daemon response type")
                return result

    def request(self, method: str, params: dict) -> dict:
        self.request_id += 1
        self.deadline = time.monotonic() + DAEMON_RPC_TIMEOUT
        self.send_frame(json.dumps({"id": self.request_id, "method": method, "params": params}).encode())
        while True:
            response = self.receive_message()
            if "method" in response or response.get("id") != self.request_id:
                continue
            if "error" in response:
                error = response["error"]
                detail = str(error.get("message", "unknown RPC error"))[:500] if isinstance(error, dict) else "invalid RPC error"
                raise SyncError(f"daemon rejected {method}: {detail}; provider was not verified")
            if not isinstance(response.get("result"), dict):
                raise SyncError(f"invalid daemon {method} result")
            return response["result"]


def requested_model_provider(command: list[str]) -> str | None:
    provider = None
    position = 0
    while position < len(command):
        argument = command[position]
        position += 1
        if argument == "--":
            break
        if argument in ("-c", "--config") and position < len(command):
            assignment = command[position]
            position += 1
        elif argument.startswith("--config="):
            assignment = argument[len("--config="):]
        elif argument.startswith("-c") and len(argument) > 2:
            assignment = argument[2:]
        else:
            continue
        match = re.fullmatch(r"\s*model_provider\s*=\s*(.*?)\s*", assignment)
        if match:
            value = match[1]
            try:
                provider = json.loads(value) if value.startswith('"') else value.strip("'")
            except ValueError as exc:
                raise SyncError("invalid model_provider override") from exc
            if not isinstance(provider, str) or not provider:
                raise SyncError("model_provider must be a nonempty string")
    return provider


@contextmanager
def ensure_daemon_provider(endpoint: Path, daemon_pid: int, session_id: str, provider: str):
    """Verify the provider and retain the subscription while the TUI takes over."""
    with DaemonClient(endpoint, daemon_pid) as client:
        params = {"threadId": session_id, "excludeTurns": True}
        thread = client.request("thread/read", {"threadId": session_id, "includeTurns": False})["thread"]
        status = thread.get("status", {}).get("type")
        can_override = status in ("idle", "systemError", "notLoaded")
        current = client.request("thread/resume", dict(params, modelProvider=provider) if can_override else params)
        if current.get("modelProvider") != provider and not can_override:
            raise SyncError(
                f"session {session_id} is {status}; cannot change provider "
                f"from {current.get('modelProvider')} to {provider} while active. "
                "Stop or finish that turn first; no task was interrupted by this wrapper"
            )
        verified = client.request("thread/resume", params)
        if current.get("modelProvider") != provider or verified.get("modelProvider") != provider:
            raise SyncError(
                f"daemon did not apply requested provider {provider}; "
                f"actual={verified.get('modelProvider')}. Refusing to launch with the wrong provider"
            )
        yield


def synchronize_and_run(args: argparse.Namespace) -> int:
    if not UUID_RE.fullmatch(args.session_id):
        raise SyncError(f"invalid session UUID: {args.session_id}")
    args.session_id = args.session_id.lower()
    homes = unique_homes(args.target_home, args.source_homes)
    target_home = homes[0]
    with ExitStack() as guards:
        guards.enter_context(session_lock(args.lock_home, args.session_id))
        resume_index = interactive_resume_index(args.command)
        daemon = (local_daemon_writer(target_home, args.session_id)
                  if args.session_action == "resume" and resume_index is not None else None)
        if daemon is not None:
            daemon_pid, endpoint = daemon
            for home in homes[1:]:
                native_writer_guard(home, args.session_id, guards)
            provider = requested_model_provider(args.command)
            if provider is not None:
                guards.enter_context(ensure_daemon_provider(endpoint, daemon_pid, args.session_id, provider))
                print(f"[{args.log_prefix}] verified_runtime_provider={provider}", file=sys.stderr)
            command = args.command.copy()
            command[resume_index + 1:resume_index + 1] = ["--remote", f"unix://{endpoint}"]
            print(
                f"[{args.log_prefix}] reattach_session={args.session_id} daemon_pid={daemon_pid}\n"
                f"[{args.log_prefix}] existing daemon context; no history synchronization. "
                "Other model/cwd overrides remain subject to native Codex support.",
                file=sys.stderr,
            )
            return run_command(command)
        native_guards = {
            home: native_writer_guard(home, args.session_id, guards) for home in homes
        }
        synchronize(args)
        if not args.command:
            return 0
        if args.session_action == "fork":
            guards.close()
        else:
            native_guards[target_home].close()
        return run_command(args.command)


def main() -> int:
    args = parse_args()
    try:
        return synchronize_and_run(args)
    except (OSError, ValueError, sqlite3.Error, SyncError) as exc:
        print(f"{args.log_prefix}: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
